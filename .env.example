# Configuration de l'application Quiz Interactif
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement

# ==============================================================================
# Configuration Ollama
# ==============================================================================

# Adresse du serveur Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modèle LLM à utiliser (doit être disponible dans Ollama)
OLLAMA_MODEL=mistral

# ==============================================================================
# Configuration Streamlit
# ==============================================================================

# Port sur lequel Streamlit doit écouter
STREAMLIT_PORT=8501

# Mode serveur (default ou client)
STREAMLIT_SERVER_MODE=default

# ==============================================================================
# Configuration de développement
# ==============================================================================

# Activer le mode debug (affiche plus de logs)
DEBUG=false

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Notes
# ==============================================================================
# - OLLAMA_BASE_URL doit pointer vers votre instance Ollama locale
# - Assurez-vous que le modèle OLLAMA_MODEL est téléchargé avec: ollama pull mistral
# - Ces variables d'environnement sont optionnelles ; les valeurs par défaut
#   sont codées dans app.py
