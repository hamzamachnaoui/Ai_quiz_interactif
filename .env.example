# Configuration de l'application Quiz Interactif avec Groq
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement

# ==============================================================================
# Configuration Groq (REQUIS)
# ==============================================================================

# Clé API Groq (récupérez-la sur https://console.groq.com/keys)
# ⚠️ JAMAIS commiter cette clé en public !
GROQ_API_KEY=gsk_votre_clé_ici

# Modèle LLM Groq à utiliser
# Options: mixtral-8x7b-32768 (recommandé), llama-2-70b-chat, gemma-7b-it
GROQ_MODEL=mixtral-8x7b-32768

# ==============================================================================
# Configuration Streamlit (Optionnel)
# ==============================================================================

# Port sur lequel Streamlit doit écouter
STREAMLIT_PORT=8501

# Mode serveur (default ou client)
STREAMLIT_SERVER_MODE=default

# ==============================================================================
# Configuration de développement
# ==============================================================================

# Activer le mode debug (affiche plus de logs)
DEBUG=false

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Notes
# ==============================================================================
# - GROQ_API_KEY est OBLIGATOIRE pour faire fonctionner l'application
# - Obtenez une clé gratuite: https://console.groq.com
# - Dépôt du projet: https://github.com/hamzamachnaoui/Ai_quiz_interactif
# - Ne commitez JAMAIS ce fichier avec votre vraie clé API !
